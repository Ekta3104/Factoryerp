# Server
PORT=5000
NODE_ENV=development

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factoryerp

# CORS — set to the deployed frontend's origin in production
CORS_ORIGIN=https://erp.balwancement.com

# JWT — use a long, random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=supersecretjwtkey_for_development
JWT_EXPIRES_IN=1d

# Seed script — used ONLY by server/scripts/seedAdmin.js
# SEED_PASSWORD is required; the script will exit if not set.
SEED_USERNAME=admin
SEED_EMAIL=admin@factoryerp.com
SEED_PASSWORD=change_me_immediately
SEED_ROLE=Admin
